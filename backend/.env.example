# ==============================================================================
# DATANOVA EXTRACT BACKEND CONFIGURATION (v2 PRODUCTION & HACKATHON)
# ==============================================================================

# API Keys for AI Providers (Not required if FEATURE_DEMO_MODE=true)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# LLM Providers (Options: openai, google)
LLM_PROVIDER_VISION=google
LLM_PROVIDER_EXTRACTOR=openai
LLM_PROVIDER_JUDGE=openai

# Model Names
VISION_MODEL=gemini-2.5-flash
EXTRACTOR_MODEL=gpt-4o
JUDGE_MODEL=gpt-4o

# Ingestion Constraints & Processing Parameters
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=8
PDF_RENDER_DPI=200

# LLM Execution Controls
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2

# Validation & Quality Assurance Thresholds
REVIEW_THRESHOLD=0.85
MATH_TOLERANCE=0.01

# Network & Server Configuration
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Feature Flags
FEATURE_STREAMING=true
FEATURE_GROUNDING=true
FEATURE_PERSISTENCE=true
FEATURE_BATCH=true
FEATURE_EXPORTS=true
FEATURE_EVAL=true
FEATURE_DEMO_MODE=false

# Persistence & Storage
DATABASE_URL=sqlite+aiosqlite:///./datanova.db
MAX_HISTORY_ITEMS=200

# Batch Ingestion
BATCH_MAX_FILES=20
BATCH_CONCURRENCY=3

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10
SECURITY_HEADERS=true
TRUSTED_HOSTS=*
API_KEY=

# Observability & Cost Tracking
COST_TRACKING=true
PRICE_TABLE_JSON={"gpt-4o": {"input": 2.50, "output": 10.00}, "gemini-2.5-flash": {"input": 0.15, "output": 0.60}}
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
